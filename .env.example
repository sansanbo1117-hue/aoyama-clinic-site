# Postgresの接続文字列。
# Supabaseの場合：Project Settings → Database → Connection string で取得。
#   DATABASE_URL … Transaction pooler（6543番ポート、?pgbouncer=true）
#   DIRECT_URL   … Direct connection（5432番ポート）※マイグレーション実行用
# 他アプリと同じPostgresインスタンス/プロジェクトを共有する場合は、
# 両方の接続文字列の末尾に `&schema=専用スキーマ名` を付けてスキーマを分離してください
# （事前に `create schema if not exists 専用スキーマ名;` の実行が必要です）。
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true&schema=aoyama_clinic"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=aoyama_clinic"

# 管理画面（/admin）のログインパスワード。必ず変更してください。
ADMIN_PASSWORD="change-this-password"

# 管理セッションCookieの署名に使うランダムな文字列。必ず変更してください。
# 生成例: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-long-random-string"

# 診察券番号の暗号化・検索用シークレット。SESSION_SECRETとは別の値を設定してください。
DATA_ENCRYPTION_KEY="change-this-to-a-64-character-random-string"
CARD_NUMBER_HMAC_SECRET="change-this-to-another-random-string"

# open / phone_only / maintenance
INTAKE_MODE="open"

# 本番公開ドメインが決まったら設定（sitemap.xml・OGP・canonicalに使用）。
# NEXT_PUBLIC_SITE_URL="https://example.com"

# 予約確定メール（Resend）。未設定時は予約を確定し、通知ジョブを未送信として保持します。
RESEND_API_KEY="re_..."
EMAIL_FROM="青山整形外科クリニック <no-reply@example.com>"
RESEND_WEBHOOK_SECRET="whsec_..."
STAFF_NOTIFICATION_EMAIL="受付通知を受け取るメールアドレス"

# 前日リマインドCronの認証。未設定の場合、Cronエンドポイントは503を返し起動しません（必須）。
CRON_SECRET="replace-with-a-long-random-secret"

# 予約API等のレート制限に使うUpstash Redis（Vercel Marketplaceから接続可）。
# 未設定の場合、インスタンス単位のメモリ実装にフォールバックします
# （ローカル開発では十分ですが、本番のサーバーレス環境では確実に機能しないため公開前に設定してください）。
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXXaaaa..."
