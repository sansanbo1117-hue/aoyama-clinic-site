// Vercel等サーバーレス環境はファイルシステムが永続化されないため、
// Postgresを使用します。
//
// Supabase等、接続プーラー(PgBouncer)経由での接続を推奨する環境では、
// DATABASE_URL に「プール接続文字列」、DIRECT_URL に「直接接続文字列」
// を設定してください（マイグレーションはプール接続だと失敗する場合が
// あるため、directUrl 経由で直接接続を使います）。
// 他アプリと同じPostgresインスタンスを共有する場合は、接続文字列の末尾に
// `?schema=専用スキーマ名` を付けてスキーマを分離してください。

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Web予約（初診・再診・予約変更・キャンセル）
model Reservation {
  id          String   @id @default(cuid())
  type        String // initial | followup | change | cancel
  name        String
  nameKana    String?
  phone       String
  email       String?
  birthDate   String?
  desiredDate String
  desiredTime String // am | pm_early | pm_late
  symptom     String?
  notes       String?
  status      String   @default("pending") // pending | confirmed | cancelled | done
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// お知らせ（休診・診療時間変更などを管理画面から更新）
model NewsPost {
  id          String   @id @default(cuid())
  title       String
  body        String
  category    String // general | closure | hours_change | obon | year_end
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// お問い合わせフォーム
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  status    String   @default("new") // new | read | handled
  createdAt DateTime @default(now())

  @@index([status])
}
